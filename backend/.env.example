# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DATABASE_URL="postgresql://notez:notez@localhost:5432/notez?schema=public"

# Security
JWT_ACCESS_SECRET=change-me-to-random-64-char-string-in-production
JWT_REFRESH_SECRET=change-me-to-different-random-64-char-string
COOKIE_SECRET=change-me-to-random-64-char-string-for-cookie-signing
ENCRYPTION_KEY=change-me-to-random-32-char-string

# CORS
CORS_ORIGIN=http://localhost:5173

# AI Provider API Keys (optional, can be configured via UI)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Added 2026-10-11 (known issue #65) ---
# Single sign-on (OpenID Connect). Optional: leave empty to disable.
# For local dev set APP_URL to the Vite origin and register
# http://localhost:5173/api/auth/oidc/callback on a separate dev client (docs/deployment.md).
APP_URL=http://localhost:5173
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REQUIRED_GROUP=
