// Notez Database Schema
// PostgreSQL with pgvector for future AI features

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL can be:
  // 1. Explicitly set as postgresql://user:pass@host:port/db
  // 2. Auto-constructed from POSTGRES_USER, POSTGRES_PASSWORD, etc.
  // See backend/src/lib/database-url.ts for construction logic
  url      = env("DATABASE_URL")
}

// User accounts
model User {
  id                 String    @id @default(uuid())
  username           String    @unique @db.VarChar(50)
  email              String?   @unique @db.VarChar(255)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  role               String    @default("user") @db.VarChar(20) // 'admin' or 'user'
  isActive           Boolean   @default(true) @map("is_active")
  isServiceAccount   Boolean   @default(false) @map("is_service_account")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  avatarUrl          String?   @map("avatar_url") @db.VarChar(255)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  sessions            Session[]
  folders             Folder[]
  notes               Note[]
  tags                Tag[]
  tasks               Task[]
  images              Image[]
  aiSettings          UserAISettings?
  passwordResetTokens PasswordResetToken[]
  feedbackSubmissions FeedbackSubmission[]
  notifications       Notification[]
  sharedByMe          NoteShare[] @relation("sharedByUser")
  sharedWithMe        NoteShare[] @relation("sharedWithUser")
  apiTokens           ApiToken[]
  webhooks            Webhook[]
  oauthApprovedClients OAuthClient[] @relation("oauthClientApprovedBy")
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthAccessTokens   OAuthAccessToken[]
  oauthConsents       OAuthUserConsent[]

  @@index([isServiceAccount])
  @@map("users")
}

// Session management for refresh tokens
model Session {
  id     String @id @default(uuid())
  userId String @map("user_id")
  // SHA-256 hex digest of the refresh token, never the token itself. Storing the
  // raw JWT meant anyone who could read the database — a leaked backup, a restic
  // archive, a SQL injection — held directly replayable credentials, since
  // /api/auth/refresh only needs the token value. Matches how ApiToken,
  // OAuthAccessToken and OAuthAuthorizationCode are persisted.
  refreshTokenHash String   @unique @map("refresh_token_hash") @db.VarChar(64)
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Folders for organizing notes
model Folder {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  name             String   @db.VarChar(255)
  icon             String   @default("folder") @db.VarChar(50) // Lucide icon name
  createdByTokenId String?  @map("created_by_token_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByToken ApiToken? @relation("folderCreatedByToken", fields: [createdByTokenId], references: [id], onDelete: SetNull)
  notes          Note[]
  tasks          Task[]

  @@unique([userId, name])
  @@index([createdByTokenId])
  @@map("folders")
}

// Notes
model Note {
  id               String                    @id @default(uuid())
  userId           String                    @map("user_id")
  folderId         String?                   @map("folder_id")
  title            String                    @db.VarChar(500)
  content          String?                   @db.Text
  searchVector     Unsupported("tsvector")?  @map("search_vector")
  deleted          Boolean                   @default(false)
  deletedAt        DateTime?                 @map("deleted_at")
  createdByTokenId String?                   @map("created_by_token_id")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  // Relations
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder         Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdByToken ApiToken?     @relation("noteCreatedByToken", fields: [createdByTokenId], references: [id], onDelete: SetNull)
  tags           NoteTag[]
  tasks          Task[]
  images         Image[]
  sourceLinks    NoteLink[]    @relation("sourceLinks")
  shares         NoteShare[]
  yjsState       NoteYjsState?

  @@index([searchVector], type: Gin)
  @@index([createdByTokenId])
  @@map("notes")
}

// Tags
model Tag {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  name             String   @db.VarChar(100)
  createdByTokenId String?  @map("created_by_token_id")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByToken ApiToken? @relation("tagCreatedByToken", fields: [createdByTokenId], references: [id], onDelete: SetNull)
  notes          NoteTag[]
  taskTags       TaskTag[]

  @@unique([userId, name])
  @@index([createdByTokenId])
  @@map("tags")
}

// Note-Tag junction table
model NoteTag {
  noteId String @map("note_id")
  tagId  String @map("tag_id")

  // Relations
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tags")
}

// Tasks (standalone or linked to notes)
model Task {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  title            String      @db.VarChar(500)
  description      String?     @db.Text
  status           TaskStatus  @default(PENDING)
  priority         Priority    @default(MEDIUM)
  dueDate          DateTime?   @map("due_date")

  // Note linkback (null for standalone tasks)
  noteId           String?     @map("note_id")
  noteTitle        String?     @map("note_title") @db.VarChar(500)

  // Organization
  folderId         String?     @map("folder_id")

  // Agent attribution
  createdByTokenId String?     @map("created_by_token_id")

  // Timestamps
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  completedAt      DateTime?   @map("completed_at")

  // Relations
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  note           Note?       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  folder         Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdByToken ApiToken?   @relation("taskCreatedByToken", fields: [createdByTokenId], references: [id], onDelete: SetNull)
  tags           TaskTag[]
  links          TaskLink[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, priority])
  @@index([userId, createdAt])
  @@index([noteId])
  @@index([createdByTokenId])
  @@map("tasks")
}

// Task-Tag junction table
model TaskTag {
  taskId String @map("task_id")
  tagId  String @map("tag_id")

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

// Task hyperlinks (external URLs attached to tasks)
model TaskLink {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  url       String   @db.VarChar(2048)
  title     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_links")
}

// Task status enum
enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Task priority enum
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// System settings (key-value store)
model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     String?  @db.Text
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// User AI Settings (per-user AI provider configuration)
model UserAISettings {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  provider         String   @db.VarChar(20) // 'anthropic', 'openai', or 'gemini'
  encryptedApiKey  String   @map("encrypted_api_key") @db.Text
  model            String?  @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_ai_settings")
}

// Image storage metadata
model Image {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  noteId    String?  @map("note_id")
  filename  String   @db.VarChar(255)
  mimeType  String   @map("mime_type") @db.VarChar(50)
  size      Int      // File size in bytes
  width     Int?
  height    Int?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note? @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([noteId])
  @@map("images")
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(100)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// Note links for wiki-style [[references]]
model NoteLink {
  id            String   @id @default(uuid())
  sourceNoteId  String   @map("source_note_id")
  targetKeyword String   @map("target_keyword") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  sourceNote Note @relation("sourceLinks", fields: [sourceNoteId], references: [id], onDelete: Cascade)

  @@unique([sourceNoteId, targetKeyword])
  @@index([targetKeyword])
  @@index([sourceNoteId])
  @@map("note_links")
}

// Feedback submission types
enum FeedbackType {
  BUG
  FEATURE
}

// Feedback submission status
enum FeedbackStatus {
  NEW
  REVIEWED
  APPROVED
  PUBLISHED
  DECLINED
}

// User feedback submissions (bug reports and feature requests)
model FeedbackSubmission {
  id              String          @id @default(uuid())
  type            FeedbackType
  title           String          @db.VarChar(100)
  description     String          @db.Text
  category        String?         @db.VarChar(50)
  priority        String?         @db.VarChar(50)
  status          FeedbackStatus  @default(NEW)
  adminNotes      String?         @map("admin_notes") @db.Text

  // GitHub integration
  githubIssueUrl    String?       @map("github_issue_url") @db.VarChar(500)
  githubIssueNumber Int?          @map("github_issue_number")

  // AI enhancement cache (stores enhanced content as JSON)
  enhancedContent   Json?         @map("enhanced_content")

  // Shipped status for "User Requested" badge
  shipped           Boolean       @default(false)
  shippedAt         DateTime?     @map("shipped_at")

  // User relation
  userId          String          @map("user_id")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  reviewedAt      DateTime?       @map("reviewed_at")
  publishedAt     DateTime?       @map("published_at")

  @@index([userId])
  @@index([status])
  @@index([type, status])
  @@map("feedback_submissions")
}

// User notifications
model Notification {
  id        String    @id @default(uuid())
  type      String    @db.VarChar(50)  // NEW_FEEDBACK, STATUS_CHANGE, etc.
  title     String    @db.VarChar(200)
  message   String?   @db.Text
  isRead    Boolean   @default(false) @map("is_read")

  // Link to related entity
  linkType  String    @map("link_type") @db.VarChar(50)  // feedback, note, etc.
  linkId    String    @map("link_id")

  // Recipient
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// Share permission levels
enum SharePermission {
  VIEW
  EDIT
}

// Note sharing - tracks who has access to shared notes
model NoteShare {
  id           String          @id @default(uuid())
  noteId       String          @map("note_id")
  ownerId      String          @map("owner_id")
  sharedWithId String          @map("shared_with_id")
  permission   SharePermission @default(VIEW)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  note       Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  owner      User @relation("sharedByUser", fields: [ownerId], references: [id], onDelete: Cascade)
  sharedWith User @relation("sharedWithUser", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([noteId, sharedWithId])
  @@index([sharedWithId])
  @@index([noteId])
  @@map("note_shares")
}

// Yjs CRDT state for collaborative editing
model NoteYjsState {
  noteId    String   @id @map("note_id")
  state     Bytes
  updatedAt DateTime @updatedAt @map("updated_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("note_yjs_state")
}

// Webhook subscriptions
model Webhook {
  id                      String    @id @default(uuid())
  userId                  String    @map("user_id")
  url                     String    @db.VarChar(2048)
  events                  String[]  // ["task.created", "task.updated", ...] or ["*"]
  encryptedSecret         String    @map("encrypted_secret") @db.Text
  secretExpiresAt         DateTime? @map("secret_expires_at")  // for rotation grace period
  encryptedPreviousSecret String?   @map("encrypted_previous_secret") @db.Text  // old secret during rotation
  metadata                Json?
  status                  String    @default("active") @db.VarChar(20)  // active, paused, disabled
  consecutiveFailures     Int       @default(0) @map("consecutive_failures")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
  @@index([status])
  @@map("webhooks")
}

// Webhook event log (source of truth for what happened)
model WebhookEvent {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  eventType    String    @map("event_type") @db.VarChar(50)
  entityType   String    @map("entity_type") @db.VarChar(20)  // task, note, folder
  entityId     String    @map("entity_id")
  data         Json      // full entity state at time of event
  previousData Json?     @map("previous_data")  // changed fields with previous values
  createdAt    DateTime  @default(now()) @map("created_at")

  deliveries WebhookDelivery[]

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId, eventType])
  @@map("webhook_events")
}

// Webhook delivery attempts (one per webhook × event × attempt)
model WebhookDelivery {
  id             String    @id @default(uuid())
  webhookId      String    @map("webhook_id")
  eventId        String    @map("event_id")
  url            String    @db.VarChar(2048)
  requestHeaders Json?     @map("request_headers")
  requestBody    String?   @map("request_body") @db.Text
  responseStatus Int?      @map("response_status")
  responseBody   String?   @map("response_body") @db.Text
  responseTimeMs Int?      @map("response_time_ms")
  attemptNumber  Int       @default(0) @map("attempt_number")
  status         String    @default("pending") @db.VarChar(20)  // pending, success, failed, cancelled
  nextRetryAt    DateTime? @map("next_retry_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  webhook Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event   WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

// API tokens for MCP and external integrations
model ApiToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String    @db.VarChar(100)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  prefix     String    @db.VarChar(10)
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")

  // Agent configuration
  isAgent    Boolean   @default(false) @map("is_agent")
  agentName  String?   @map("agent_name") @db.VarChar(50)
  agentIcon  String?   @map("agent_icon") @db.VarChar(50)
  agentColor String?   @map("agent_color") @db.VarChar(7) // hex color e.g. #8B5CF6

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Reverse relations for content attribution
  createdNotes   Note[]   @relation("noteCreatedByToken")
  createdFolders Folder[] @relation("folderCreatedByToken")
  createdTags    Tag[]    @relation("tagCreatedByToken")
  createdTasks   Task[]   @relation("taskCreatedByToken")

  @@index([userId])
  @@index([userId, isAgent])
  @@map("api_tokens")
}

// OAuth 2.1 clients registered via Dynamic Client Registration (RFC 7591)
// Used by remote MCP connectors (claude.ai, etc.)
model OAuthClient {
  id                  String    @id @default(uuid())
  clientId            String    @unique @map("client_id") @db.VarChar(255)
  clientSecretHash    String    @map("client_secret_hash") @db.VarChar(255)
  clientSecretExpiresAt DateTime? @map("client_secret_expires_at")
  clientName          String?   @map("client_name") @db.VarChar(255)
  clientUri           String?   @map("client_uri") @db.VarChar(2048)
  redirectUris        String[]  @map("redirect_uris")
  grantTypes          String[]  @default(["authorization_code", "refresh_token"]) @map("grant_types")
  responseTypes       String[]  @default(["code"]) @map("response_types")
  scope               String?   @db.VarChar(500) // space-separated scopes
  tokenEndpointAuthMethod String @default("client_secret_post") @map("token_endpoint_auth_method") @db.VarChar(50)
  status              String    @default("pending_approval") @db.VarChar(20) // pending_approval, approved, rejected, revoked
  approvedByUserId    String?   @map("approved_by_user_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  approvedBy          User?     @relation("oauthClientApprovedBy", fields: [approvedByUserId], references: [id])
  authorizationCodes  OAuthAuthorizationCode[]
  accessTokens        OAuthAccessToken[]
  userConsents        OAuthUserConsent[]

  @@index([status])
  @@map("oauth_clients")
}

// OAuth 2.1 authorization codes (short-lived, single-use)
model OAuthAuthorizationCode {
  id                  String    @id @default(uuid())
  codeHash            String    @unique @map("code_hash") @db.VarChar(64)
  clientId            String    @map("client_id")
  userId              String    @map("user_id")
  redirectUri         String    @map("redirect_uri") @db.VarChar(2048)
  scope               String    @db.VarChar(500) // space-separated scopes granted
  codeChallenge       String    @map("code_challenge") @db.VarChar(255)
  codeChallengeMethod String    @default("S256") @map("code_challenge_method") @db.VarChar(10)
  expiresAt           DateTime  @map("expires_at")
  usedAt              DateTime? @map("used_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  client  OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_authorization_codes")
}

// OAuth 2.1 access + refresh tokens
model OAuthAccessToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique @map("token_hash") @db.VarChar(64)
  clientId            String    @map("client_id")
  userId              String    @map("user_id")
  scope               String    @db.VarChar(500) // space-separated scopes
  expiresAt           DateTime  @map("expires_at")
  refreshTokenHash    String?   @unique @map("refresh_token_hash") @db.VarChar(64)
  refreshExpiresAt    DateTime? @map("refresh_expires_at")
  refreshRotatedAt    DateTime? @map("refresh_rotated_at") // set when refresh token is rotated (replay detection)
  revokedAt           DateTime? @map("revoked_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  client  OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([refreshTokenHash])
  @@map("oauth_access_tokens")
}

// Cached user consent (suppresses re-consent for 30 days per client+user)
model OAuthUserConsent {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  clientId            String    @map("client_id")
  scope               String    @db.VarChar(500) // space-separated scopes consented
  grantedAt           DateTime  @default(now()) @map("granted_at")
  expiresAt           DateTime  @map("expires_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client  OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@map("oauth_user_consents")
}
