# Notez Environment Variables
# Copy this file to .env and fill in the values

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=notez
POSTGRES_PASSWORD=          # Required — strong random password
POSTGRES_DB=notez

# ── Authentication ────────────────────────────────────────
JWT_ACCESS_SECRET=          # Required — openssl rand -base64 32
JWT_REFRESH_SECRET=         # Required — openssl rand -base64 32
ENCRYPTION_KEY=             # Required — openssl rand -base64 32
COOKIE_SECRET=              # Optional — defaults to JWT_REFRESH_SECRET

# ── MinIO (S3-compatible storage) ─────────────────────────
MINIO_ACCESS_KEY=notez
MINIO_SECRET_KEY=           # Required — strong random password

# ── Email (password reset) ────────────────────────────────
RESEND_API_KEY=             # Optional — enables password reset emails
EMAIL_FROM=noreply@example.com

# ── Application ───────────────────────────────────────────
APP_NAME=Notez
APP_URL=https://notez.example.com
CORS_ORIGIN=https://notez.example.com

# ── Remote MCP Connector (claude.ai mobile/web access) ────
MCP_REMOTE_ENABLED=false    # Set to "true" to enable remote MCP connector
MCP_ALLOWED_ORIGINS=https://claude.ai,https://www.claude.ai

# ── Storage paths ─────────────────────────────────────────
DATA_DIR=/opt/notez         # Host directory for persistent data

# --- local dev overrides (added 2026-07-28) ---------------------------------
# compose.yml now interpolates these as ${KEY:-<placeholder>}, so local dev behaviour is
# unchanged if you set nothing. Set them here to override.
# The in-file defaults are PLACEHOLDERS (hyphenated lowercase words, no entropy) - they are not
# and must never become real secrets. Production values live in compose.prod.yml's .env.
POSTGRES_USER=
POSTGRES_PASSWORD=
ENCRYPTION_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Added 2026-10-11 (known issue #65) ---
# Single sign-on (OpenID Connect, e.g. Pocket ID). Optional: leave all four empty to disable.
# Register this callback at the provider: <APP_URL>/api/auth/oidc/callback
# OIDC_ISSUER must be the issuer exactly as the provider publishes it.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional: also require this group in the ID token's groups claim
OIDC_REQUIRED_GROUP=

# Optional: place the two data directories anywhere instead of under DATA_DIR
# (defaults: ${DATA_DIR}/data/postgres and ${DATA_DIR}/data/minio)
# POSTGRES_DATA_DIR=
# MINIO_DATA_DIR=
